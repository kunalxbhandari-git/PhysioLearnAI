# ── PhysioLearn AI environment ─────────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL (Neon) connection strings.
# DATABASE_URL is the POOLED connection (host contains "-pooler") used at runtime.
# DIRECT_DATABASE_URL is the same string without "-pooler", used for schema pushes/seeding.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Password for the site gate. Validated server-side only.
APP_PASSWORD="change-me"

# Secret used to sign the session cookie (any long random string).
# Generate one with:  openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# ── Optional AI providers ──────────────────────────────────────────────────
# When nothing is configured, the app uses its built-in deterministic local
# provider, so everything still works fully offline.

# AI provider to use: "local" (default), "ollama" (free, runs on this machine),
# or "anthropic" (paid API)
AI_PROVIDER="ollama"

# Ollama — completely free local AI (https://ollama.com).
# Install Ollama, run `ollama pull llama3.2`, and keep the Ollama service running.
OLLAMA_MODEL="llama3.2"
# OLLAMA_URL="http://localhost:11434"

# Anthropic API key (alternative provider, paid)
# ANTHROPIC_API_KEY=""

# Image provider: "local" (default, curated SVG illustrations)
# IMAGE_PROVIDER="local"
